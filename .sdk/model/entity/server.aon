# Entity: server

main: kit: entity: server: {

  alias: field: {}

  fields: [
    {
      name: "city"
      req: false
      short: "City where the server is located"
      type: "`$STRING`"
    }
    {
      name: "country"
      req: false
      short: "Country where the server is located"
      type: "`$STRING`"
    }
    {
      name: "countryCode"
      req: false
      short: "ISO country code"
      type: "`$STRING`"
    }
    {
      name: "host"
      req: false
      short: "Server hostname or IP address"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the server"
      type: "`$STRING`"
    }
    {
      name: "load"
      req: false
      short: "Server load percentage"
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "Display name of the server"
      type: "`$STRING`"
    }
    {
      name: "online"
      req: false
      short: "Whether the server is currently online"
      type: "`$BOOLEAN`"
    }
    {
      name: "port"
      req: false
      short: "Server port number"
      type: "`$INTEGER`"
    }
    {
      name: "premium"
      req: false
      short: "Whether this is a premium server"
      type: "`$BOOLEAN`"
    }
    {
      name: "protocol"
      req: false
      short: "VPN protocol used by the server"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "server"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/servers"
          segments: [
            {
              lit: "servers"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
