# Entity: request_info

main: kit: entity: request_info: {

  alias: field: {}

  fields: [
    {
      name: "city"
      req: false
      short: "City"
      type: "`$STRING`"
    }
    {
      name: "country"
      req: false
      short: "Country of the IP address"
      type: "`$STRING`"
    }
    {
      name: "ip"
      req: false
      short: "The IP address of the requester"
      type: "`$STRING`"
    }
    {
      name: "region"
      req: false
      short: "Region or state"
      type: "`$STRING`"
    }
  ]

  name: "request_info"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/request-ip"
          parts: [
            "request-ip"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
